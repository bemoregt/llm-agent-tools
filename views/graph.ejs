<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>지식 그래프</title>
  <link rel="stylesheet" href="/static/style.css">
  <style>
    html, body { margin: 0; padding: 0; overflow: hidden; background: #000; height: 100%; }
    #graph-canvas { display: block; width: 100vw; height: 100vh; }

    .graph-overlay {
      position: fixed;
      z-index: 10;
      font-family: "SFMono-Regular", Menlo, monospace;
      color: #ffffff;
      text-shadow: 0 0 6px rgba(255, 255, 255, 0.5);
      pointer-events: none;
    }
    .graph-overlay a, .graph-overlay button {
      pointer-events: auto;
    }

    .graph-topbar {
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      background: linear-gradient(to bottom, rgba(0,0,0,0.75), rgba(0,0,0,0));
    }
    .graph-topbar a {
      color: #ffffff;
      text-decoration: none;
      font-weight: bold;
      border: 1px solid #ffffff;
      padding: 4px 10px;
      background: rgba(0,0,0,0.4);
    }
    .graph-topbar a:hover { background: rgba(255,255,255,0.15); }
    .graph-title { font-size: 1em; letter-spacing: 0.08em; }

    .graph-hint {
      bottom: 12px;
      left: 16px;
      max-width: calc(100vw - 260px);
      font-size: 0.8em;
      line-height: 1.6;
      background: rgba(0,0,0,0.4);
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,0.3);
    }

    .graph-status {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 1em;
    }
  </style>
</head>
<body>
  <canvas id="graph-canvas"></canvas>

  <div class="graph-overlay graph-topbar">
    <a href="/">← 위키로</a>
    <span class="graph-title">🕸️ 지식 그래프</span>
    <span></span>
  </div>

  <div class="graph-overlay graph-hint">
    버튼 클릭: 날아 들어가기(없으면 새 탭에서 열기) &nbsp;|&nbsp; 빈 곳 클릭: 뒤로
  </div>

  <div class="graph-overlay graph-status" id="graph-status">그래프를 불러오는 중...</div>

  <script src="/static/vendor/three.min.js"></script>
  <script src="/static/graph.js"></script>
</body>
</html>
