<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title><%= typeof name !== 'undefined' ? name : 'Wiki' %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand"><a href="/">📖 Wiki</a></div>

      <div class="side-section" id="ai-status-section">
        <h3>🤖 AI 엔진</h3>
        <p class="side-hint" id="ai-status-text">
          <span id="ai-status-dot" class="ai-status-dot"></span>
          <span id="ai-status-model">불러오는 중…</span>
        </p>
        <div class="ai-model-picker">
          <select id="ai-model-select" class="ai-model-select"></select>
        </div>
        <p class="side-hint" id="ai-model-status"></p>
      </div>

      <% if (typeof mode !== 'undefined' && mode) { %>
        <div class="side-section page-mode-actions">
          <h3>🗂️ 이 페이지</h3>
          <% if (mode === 'view') { %>
            <a class="btn big" href="/page/<%= encodeURIComponent(name) %>/edit">✏️ 편집 모드</a>
          <% } else if (mode === 'edit') { %>
            <a class="btn big" href="/page/<%= encodeURIComponent(name) %>">👁️ 보기 모드</a>
            <button type="submit" form="edit-form" class="btn big primary">💾 저장 하기</button>
          <% } %>
        </div>
      <% } %>

      <div class="side-section">
        <h3>📎 파일 업로드</h3>
        <label class="btn big file-upload-label" for="file-upload-input">📤 파일 선택</label>
        <input type="file" id="file-upload-input" class="file-upload-input">
        <p class="side-hint" id="upload-status"></p>
        <p class="side-hint">파일을 화면에 드래그&드랍해도 첨부됩니다</p>
      </div>

      <div class="side-section">
        <h3>🔍 검색</h3>
        <form action="/search" method="get">
          <input type="text" name="q" placeholder="키워드" value="<%= typeof q !== 'undefined' ? q : '' %>">
        </form>
      </div>

      <div class="side-section">
        <h3><a href="/changes">🕘 히스토리</a></h3>
        <p class="side-hint">최근 변경된 페이지</p>
      </div>

      <div class="side-section">
        <h3><a href="/pages">📚 모든 페이지</a></h3>
      </div>

      <div class="side-section">
        <h3><a href="/graph">🕸️ 지식 그래프</a></h3>
        <p class="side-hint">3D로 보는 페이지 연결망</p>
      </div>

      <div class="side-section">
        <h3><a href="/help">❓ 도움말</a></h3>
      </div>

      <% if (typeof mode !== 'undefined' && mode === 'view') { %>
        <div class="side-section">
          <h3>🔖 북마크 정리</h3>
          <button type="button" id="bookmark-sort-btn" class="btn big" data-page="<%= encodeURIComponent(name) %>">📊 많이 클릭한 순으로 정렬</button>
          <p class="side-hint" id="bookmark-sort-status">많이 클릭한 링크는 위로, 메일 링크는 상단 고정</p>
        </div>
      <% } %>
    </aside>
    <main class="content">
      <div id="drop-overlay" class="drop-overlay" style="display:none">📁 파일을 놓아주세요</div>
