<%- include('_header', { name, mode: 'view' }) %>
  <h1 class="page-name"><%= name %></h1>
  <div class="page-body">
    <%- html %>
  </div>
  <div class="copy-bar">
    <button type="button" id="copy-btn" class="btn">📋 텍스트 복사</button>
    <p class="side-hint" id="copy-status"></p>
  </div>

  <div class="glossary-bar">
    <button type="button" id="glossary-btn" class="btn">🏷️ 전문용어 페이지 만들기</button>
  </div>
  <div id="glossary-panel" class="glossary-panel" style="display:none">
    <p class="glossary-hint">체크된 단어에 대해 새 페이지를 만들고(AI가 짧은 설명을 채워넣습니다), 이 문서에서 링크로 연결합니다.</p>
    <div id="glossary-list" class="glossary-list"></div>
    <div class="glossary-actions">
      <button type="button" id="glossary-generate" class="btn primary">생성</button>
      <button type="button" id="glossary-cancel" class="btn">취소</button>
    </div>
    <p class="side-hint" id="glossary-status"></p>
  </div>

  <div class="video-bar">
    <div class="video-bar-buttons">
      <button type="button" id="make-video-btn" class="btn">🎬 유튜브 영상 만들기</button>
      <button type="button" id="make-shorts-btn" class="btn">📱 쇼츠 영상 만들기</button>
    </div>
    <p class="side-hint" id="video-status"></p>
  </div>

  <div class="bgm-bar">
    <button type="button" id="bgm-btn" class="btn">🎵 배경음악 넣기</button>
    <p class="side-hint" id="bgm-status"></p>
  </div>

  <div class="corefunc-bar">
    <button type="button" id="core-function-btn" class="btn">🧩 핵심 함수 만들기</button>
    <p class="side-hint" id="core-function-status"></p>
  </div>

  <div class="translate-bar">
    <button type="button" id="translate-btn" class="btn">🌐 영상 제목·설명 번역</button>
    <p class="side-hint" id="translate-status"></p>
  </div>

  <div class="jobsearch-bar">
    <div class="jobsearch-bar-buttons">
      <button type="button" class="btn jobsearch-btn" data-period="week">💼 최근 1주일 채용정보 찾기</button>
    </div>
    <p class="side-hint" id="jobsearch-status"></p>
  </div>

  <div class="rssfeed-bar">
    <button type="button" id="rssfeed-btn" class="btn">📡 키워드로 RSS Feed 찾기</button>
    <p class="side-hint" id="rssfeed-status"></p>
  </div>

  <div class="arxiv-bar">
    <div class="arxiv-bar-buttons">
      <button type="button" class="btn arxiv-btn" data-period="month">📚 최근 1개월 arXiv 논문 찾기</button>
    </div>
    <p class="side-hint" id="arxiv-status"></p>
  </div>

  <div class="pdfsummary-bar">
    <button type="button" id="pdfsummary-btn" class="btn">📄 첨부 PDF 논문 요약</button>
    <p class="side-hint" id="pdfsummary-status"></p>
  </div>

  <div class="relatedpages-bar">
    <button type="button" id="relatedpages-btn" class="btn">🔗 관련 문서 추천</button>
    <p class="side-hint" id="relatedpages-status"></p>
  </div>

  <div class="youtubesummary-bar">
    <button type="button" id="youtubesummary-btn" class="btn">🎥 유튜브 영상 분석·요약</button>
    <p class="side-hint" id="youtubesummary-status"></p>
  </div>

  <div class="codetest-bar">
    <button type="button" id="codetest-btn" class="btn">🧪 코드로 테스트하기</button>
    <p class="side-hint" id="codetest-status"></p>
  </div>

  <div class="resumeoptimize-bar">
    <button type="button" id="resumeoptimize-btn" class="btn">📝 이력서 최적화하기</button>
    <p class="side-hint" id="resumeoptimize-status"></p>
  </div>

  <div class="tonotebook-bar">
    <button type="button" id="tonotebook-btn" class="btn">📓 주피터 노트북으로 변경</button>
    <p class="side-hint" id="tonotebook-status"></p>
  </div>

  <div class="ofapp-bar">
    <button type="button" id="ofapp-btn" class="btn">⚙️ openFrameworks 앱 코드 만들기</button>
    <p class="side-hint" id="ofapp-status"></p>
  </div>

  <div class="swiftapp-bar">
    <button type="button" id="swiftapp-btn" class="btn">🍎 Swift iOS 앱 코드 만들기</button>
    <p class="side-hint" id="swiftapp-status"></p>
  </div>

  <div class="page-footer-nav">
    <a class="btn" id="up-btn" style="display:none"></a>
  </div>
  <script src="/static/nav.js"></script>
  <script src="/static/copytext.js"></script>
  <script src="/static/glossary.js"></script>
  <script src="/static/video.js"></script>
  <script src="/static/bgm.js"></script>
  <script src="/static/corefunc.js"></script>
  <script src="/static/translate.js"></script>
  <script src="/static/jobsearch.js"></script>
  <script src="/static/rssfeed.js"></script>
  <script src="/static/arxivsearch.js"></script>
  <script src="/static/pdfsummary.js"></script>
  <script src="/static/relatedpages.js"></script>
  <script src="/static/youtubesummary.js"></script>
  <script src="/static/codetest.js"></script>
  <script src="/static/resumeoptimize.js"></script>
  <script src="/static/tonotebook.js"></script>
  <script src="/static/ofapp.js"></script>
  <script src="/static/swift.js"></script>
  <script src="/static/finderlink.js"></script>
  <% if (html.includes('class="mermaid"')) { %>
    <script src="/static/vendor/mermaid.min.js"></script>
    <script>mermaid.initialize({ startOnLoad: true });</script>
  <% } %>
  <% if (html.includes('data-katex')) { %>
    <link rel="stylesheet" href="/static/vendor/katex/katex.min.css">
    <script src="/static/vendor/katex/katex.min.js"></script>
    <script src="/static/katexrender.js"></script>
  <% } %>
<%- include('_footer') %>
